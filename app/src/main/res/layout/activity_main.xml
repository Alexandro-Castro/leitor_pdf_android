<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tela inicial -->
    <LinearLayout
        android:id="@+id/inicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundo"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inicio_barra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:text="@string/app_name"
            android:textColor="@color/texto"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/inicio_conteudo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/botao_abrir"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/fundo_botao"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pasta"
                        android:tint="@color/sobre_marca" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/abrir_pdf"
                        android:textColor="@color/sobre_marca"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/titulo_recentes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="2dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/recentes"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/lista_recentes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/sem_recentes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/sem_recentes"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Leitor -->
    <FrameLayout
        android:id="@+id/leitor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.alexandro.leitorpdf.PdfView
            android:id="@+id/pdf"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/carregando"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/barra_topo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/barra"
            android:clickable="true"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/botao_voltar"
                style="@style/BotaoIcone"
                android:contentDescription="@string/voltar"
                android:src="@drawable/ic_voltar" />

            <TextView
                android:id="@+id/titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/texto"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/botao_abrir_outro"
                style="@style/BotaoIcone"
                android:contentDescription="@string/abrir_outro"
                android:src="@drawable/ic_pasta" />

            <ImageButton
                android:id="@+id/botao_noturno"
                style="@style/BotaoIcone"
                android:contentDescription="@string/ativar_noturno"
                android:src="@drawable/ic_noturno" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barra_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/barra"
            android:clickable="true"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/rotulo_pagina"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/fundo_pilula"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/barra_paginas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/indicador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/fundo_indicador"
            android:fontFeatureSettings="tnum"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
